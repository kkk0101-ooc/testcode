    "sourceMap": {"type":"object","additionalProperties":false,"required":["method_id","path","bytes","sha256","canonical_digest","dtype","shape"],"properties":{"method_id":{"enum":["nns_v2","vit_grad_cam"]},"path":{"type":"string"},"bytes":{"type":"integer","minimum":1},"sha256":{"$ref":"#/$defs/sha"},"canonical_digest":{"$ref":"#/$defs/sha"},"dtype":{"const":"float32"},"shape":{"const":[224,224]}}},
    "route": {"type":"object","additionalProperties":false,"required":["unit_digest","model_id","sample_id","source_status","shard","source_terminal_path","source_terminal_sha256","source_maps"],"properties":{"unit_digest":{"$ref":"#/$defs/sha"},"model_id":{"type":"string"},"sample_id":{"type":"string"},"source_status":{"enum":["VALID","FAILED_ROUTE_LOCAL_NUMERICAL"]},"shard":{"type":"integer","minimum":0,"maximum":3},"source_terminal_path":{"type":"string"},"source_terminal_sha256":{"$ref":"#/$defs/sha"},"source_maps":{"type":"array","minItems":0,"maxItems":2,"items":{"$ref":"#/$defs/sourceMap"}}}},

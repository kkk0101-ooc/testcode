    "binding": {"type":"object","additionalProperties":false,"required":["path","bytes","sha256","canonical_digest"],"properties":{"path":{"type":"string","minLength":1},"bytes":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha"},"canonical_digest":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]}}},

    "terminal": {"type":"object","additionalProperties":false,"required":["terminal","complete","immutable","next_authorization","x2_decision_modified","x3_x5_started"],"properties":{"terminal":{"type":"boolean"},"complete":{"type":"boolean"},"immutable":{"type":"boolean"},"next_authorization":{"enum":["NONE","X2_MECH_M1_TRANSFORMED_MAP_AND_MULTISCALE_FIDELITY_ONLY"]},"x2_decision_modified":{"const":false},"x3_x5_started":{"const":false}}},
    "payload": {"type":"object","additionalProperties":false,"required":["identity","bindings","checks","counts","state","files","routes","outputs","budget","estimability","attacks","access","terminal"],"properties":{"identity":{"type":"array","items":{"$ref":"#/$defs/named"}},"bindings":{"type":"array","items":{"$ref":"#/$defs/binding"}},"checks":{"type":"array","items":{"$ref":"#/$defs/check"}},"counts":{"type":"array","items":{"$ref":"#/$defs/named"}},"state":{"type":"array","items":{"$ref":"#/$defs/named"}},"files":{"type":"array","items":{"$ref":"#/$defs/binding"}},"routes":{"type":"array","items":{"$ref":"#/$defs/route"}},"outputs":{"type":"array","items":{"$ref":"#/$defs/output"}},"budget":{"type":"array","items":{"$ref":"#/$defs/budget"}},"estimability":{"type":"array","items":{"$ref":"#/$defs/estimability"}},"attacks":{"type":"array","items":{"$ref":"#/$defs/attack"}},"access":{"type":"array","items":{"$ref":"#/$defs/access"}},"terminal":{"$ref":"#/$defs/terminal"}}}

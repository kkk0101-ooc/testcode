    "budget": {"type":"object","additionalProperties":false,"required":["resource","projected","cap","unit","status"],"properties":{"resource":{"type":"string"},"projected":{"type":"number","minimum":0},"cap":{"type":"number","minimum":0},"unit":{"type":"string"},"status":{"enum":["PASS","BLOCKED_BUDGET"]}}},
    "estimability": {"type":"object","additionalProperties":false,"required":["endpoint","before_m1","after_m1_maximum","confirmatory_upgrade_allowed"],"properties":{"endpoint":{"type":"string"},"before_m1":{"const":"NOT_ESTIMABLE_FROM_RETAINED_X2_EVIDENCE"},"after_m1_maximum":{"const":"POST_HOC_EXPLORATORY_ESTIMABLE"},"confirmatory_upgrade_allowed":{"const":false}}},
    "attack": {"type":"object","additionalProperties":false,"required":["attack","result","mechanism"],"properties":{"attack":{"type":"string"},"result":{"const":"REJECTED"},"mechanism":{"type":"string"}}},

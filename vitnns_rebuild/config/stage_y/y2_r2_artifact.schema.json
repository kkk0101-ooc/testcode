        "record_count": {"type": "integer"},
        "records_digest": {"$ref": "#/$defs/sha"},
        "selection_orders": {"type": "array","items": {"type": "integer"}},
        "source_type": {"type": "string"},
        "branch": {"type": "string"},
        "head": {"$ref": "#/$defs/sha"},
        "tracking": {"$ref": "#/$defs/sha"},
        "remote_branch": {"$ref": "#/$defs/sha"},

        "quadrature_attempts": {"type": "array"},
        "scientific_result": {"type": ["object","null"]},
        "array_records": {"type": "array","items": {"$ref": "#/$defs/file"}},
        "attempt_records": {"type": "array","items": {"$ref": "#/$defs/file"}},
        "predecessor_terminal": {"$ref": "#/$defs/file"},

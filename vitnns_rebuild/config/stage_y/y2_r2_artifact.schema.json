  "$defs": {
    "sha": {"type": "string","pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object","additionalProperties": false,"required": ["path","bytes","sha256"],"properties": {"path":{"type":"string"},"bytes":{"type":"integer"},"sha256":{"$ref":"#/$defs/sha"},"canonical_digest":{"$ref":"#/$defs/sha"},"dtype":{"type":"string"},"shape":{"type":"array"},"axes":{"type":"array"}}}

    "report_root": {"const": "reports/stage_f_f3c4_analysis_r1_20260908"},
    "formal_sample_count": {"const": 50},
    "formal_statistical_unit": {"const": "image"},
    "methods": {"type": "array", "minItems": 5, "maxItems": 5},
    "statistics": {"type": "object"},
    "rendering": {"type": "object"},
    "budget": {"type": "object"},
    "access": {"type": "object"},
    "fine_grid_fidelity": {"const": "NOT_COMPUTED_NO_SEALED_F3C3_FINE_GRID_INTERVENTION_TERMINALS"},

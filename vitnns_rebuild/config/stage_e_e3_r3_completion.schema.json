    "completed_at": {"type": "string", "format": "date-time"},
    "historical_statuses": {"const": {"E3":"FAIL","E3-R1":"BLOCKED","E3-R2":"FAIL"}},
    "union": {"type": "object"},
    "package_completeness": {"const": "PASS"},
    "workflow_integrity": {"const": "PASS"},
    "scientific_validity": {"const": "PASS"},

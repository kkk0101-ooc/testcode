{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage_d_recovery_summary.schema.json",
  "title": "Stage D recovery-v2 audit and handoff",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification": {"enum": ["CURRENT_VALID_PASS", "HISTORICAL_PASS_STALE_BINDING", "SYNTHETIC_OR_IMPLEMENTATION_ONLY_PASS", "UNSUPPORTED_PASS", "INVALID_OR_TAMPERED", "BLOCKED_MISSING_EVIDENCE"]},
    "authorization": {"const": {"execution_authorization": false, "analysis_authorization": false, "reserve_access_authorization": false, "downstream_authorization": false}},
    "access": {"const": {"reserve_image_exists_checked": false, "reserve_image_statted": false, "reserve_image_opened": false, "reserve_image_hashed": false, "reserve_image_decoded": false, "reserve_image_preprocessed": false, "reserve_image_used_for_inference": false, "stage_d_outcome_accessed": false}},
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "stage", "classification", "generation", "locator", "status_or_pass_file", "evidence", "git", "input_bindings", "validation", "audit_checks", "reason"],
      "properties": {
        "record_id": {"type": "string"}, "stage": {"enum": ["D0", "D1", "D2", "D3", "D4", "D5", "D6"]},
        "classification": {"$ref": "#/$defs/classification"}, "generation": {"enum": ["HISTORICAL_ORIGINAL", "RECOVERY_V2_R1", "RECOVERY_V2_R2", "RECOVERY_V2_R3"]},
        "locator": {"type": "string"}, "status_or_pass_file": {"type": ["string", "null"]},
        "evidence": {"type": "array", "items": {"type": "string"}}, "git": {"type": "object"},
        "input_bindings": {"type": "object"}, "validation": {"type": "object"}, "audit_checks": {"type": "object"}, "reason": {"type": "string"}
      }
    }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "schema_version", "document_type", "recovery_id", "status", "classification_allowlist", "summary", "integrity_findings", "historical_records", "current_records", "historical_binding_locations", "authorization", "access_attestation", "lightweight_remote_is_complete_evidence_mirror", "canonical_digest"],
      "properties": {
        "$schema": {"const": "../../config/stage_d_recovery_summary.schema.json"}, "schema_version": {"const": 1}, "document_type": {"const": "stage_d_d0_d6_false_pass_audit"}, "recovery_id": {"const": "STAGE_D_PRE_RESERVE_RECOVERY_V2_20260904"}, "status": {"const": "PASS"},
        "classification_allowlist": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true}, "summary": {"type": "object"}, "integrity_findings": {"type": "object"},
        "historical_records": {"type": "array", "minItems": 22, "maxItems": 22, "items": {"$ref": "#/$defs/record"}}, "current_records": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/record"}},
        "historical_binding_locations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "authorization": {"$ref": "#/$defs/authorization"}, "access_attestation": {"$ref": "#/$defs/access"}, "lightweight_remote_is_complete_evidence_mirror": {"const": false}, "canonical_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["$schema", "schema_version", "document_type", "recovery_id", "handoff_status", "current_stage_status", "historical_status", "provenance_chain", "frozen_scope", "preserved_c10_status", "future_d7_requirements", "not_started", "authorization", "access_attestation", "evidence_custody", "canonical_digest"],
      "properties": {
        "$schema": {"const": "../../config/stage_d_recovery_summary.schema.json"}, "schema_version": {"const": 1}, "document_type": {"const": "stage_d_d6_to_future_d7_handoff"}, "recovery_id": {"const": "STAGE_D_PRE_RESERVE_RECOVERY_V2_20260904"}, "handoff_status": {"const": "INFORMATIONAL_FUTURE_D7_GATE_ONLY_NOT_AUTHORIZATION"},
        "current_stage_status": {"type": "array", "minItems": 7, "maxItems": 7}, "historical_status": {"type": "object"}, "provenance_chain": {"type": "array", "minItems": 10}, "frozen_scope": {"type": "object"}, "preserved_c10_status": {"type": "object"}, "future_d7_requirements": {"type": "array", "minItems": 6}, "not_started": {"const": ["D7", "D8", "D9", "D10"]}, "authorization": {"$ref": "#/$defs/authorization"}, "access_attestation": {"$ref": "#/$defs/access"}, "evidence_custody": {"type": "object"}, "canonical_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  ]
}

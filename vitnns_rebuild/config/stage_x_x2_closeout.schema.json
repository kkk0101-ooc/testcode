    "verification": {"type": "object", "additionalProperties": false, "required": ["source_recomputing_validator", "unit_terminals_validated", "artifacts_validated", "formal_journals_validated", "pending_publications", "focused_tests", "py_compile", "git_diff_check"], "properties": {"source_recomputing_validator": {"const": "PASS_EXPECTED_NO_GO"}, "unit_terminals_validated": {"const": 200}, "artifacts_validated": {"const": 2434}, "formal_journals_validated": {"const": 398}, "pending_publications": {"const": 0}, "focused_tests": {"const": "57 passed"}, "py_compile": {"const": "PASS"}, "git_diff_check": {"const": "PASS"}}},
    "downstream": {"type": "object", "additionalProperties": false, "required": ["x3_started", "x4_started", "x5_started", "x3_x5_authorized", "next_authorization"], "properties": {"x3_started": {"const": false}, "x4_started": {"const": false}, "x5_started": {"const": false}, "x3_x5_authorized": {"const": false}, "next_authorization": {"const": "F3_FINAL_FIGURE_PACKAGE_ONLY"}}},

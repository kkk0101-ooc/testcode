{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "canonical_digest": {"$ref": "#/$defs/sha"}
      },
      "required": ["path", "bytes", "sha256", "canonical_digest"]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "document_type": {"const": "stage_f_f1_terminal_completion"},
    "stage_id": {"const": "F1"},
    "status": {"const": "PASS"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "package_validation": {"const": "PASS"},
    "workflow_validation": {"const": "PASS"},
    "scientific_modules_rendered": {"const": 3},
    "layout_render_instances": {"const": 6},
    "exported_figure_files": {"const": 18},
    "final_combined_figure_2_rendered": {"const": false},
    "model_access": {"const": false},
    "torch_imported": {"const": false},
    "timm_imported": {"const": false},
    "gpu_cuda_access": {"const": false},
    "jpeg_access": {"const": false},
    "bootstrap_ci_new_endpoint_recomputed": {"const": false},
    "c10_stage_d_pooled": {"const": false},
    "d10_f0_e4_decisions_modified": {"const": false},
    "startup_gate": {"$ref": "#/$defs/record"},
    "source_binding": {"$ref": "#/$defs/record"},
    "access_audit": {"$ref": "#/$defs/record"},
    "source_validation": {"$ref": "#/$defs/record"},
    "test_report": {"$ref": "#/$defs/record"},
    "false_pass_audit": {"$ref": "#/$defs/record"},
    "render_inventory": {"$ref": "#/$defs/record"},
    "payload_manifest": {"$ref": "#/$defs/record"},
    "status_record": {"$ref": "#/$defs/record"},
    "whole_root_inventory": {"$ref": "#/$defs/record"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {"const": "SELF"},
        "ref": {"const": "refs/archive/stage-f-v1-f1-completion"}
      },
      "required": ["commit", "ref"]
    },
    "next_authorization": {"const": "F2_ONLY"},
    "f2_started": {"const": false},
    "f3_started": {"const": false},
    "f4_started": {"const": false},
    "canonical_digest": {"$ref": "#/$defs/sha"}
  },
  "required": [
    "schema_version",
    "document_type",
    "stage_id",
    "status",
    "started_at",
    "completed_at",
    "package_validation",
    "workflow_validation",
    "scientific_modules_rendered",
    "layout_render_instances",
    "exported_figure_files",
    "final_combined_figure_2_rendered",
    "model_access",
    "torch_imported",
    "timm_imported",
    "gpu_cuda_access",
    "jpeg_access",
    "bootstrap_ci_new_endpoint_recomputed",
    "c10_stage_d_pooled",
    "d10_f0_e4_decisions_modified",
    "startup_gate",
    "source_binding",
    "access_audit",
    "source_validation",
    "test_report",
    "false_pass_audit",
    "render_inventory",
    "payload_manifest",
    "status_record",
    "whole_root_inventory",
    "git",
    "next_authorization",
    "f2_started",
    "f3_started",
    "f4_started",
    "canonical_digest"
  ]
}

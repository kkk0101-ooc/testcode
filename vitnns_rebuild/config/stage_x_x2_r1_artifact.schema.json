    "terminalState": {"type":"object","additionalProperties":false,"required":["terminal","immutable","complete","next_authorization","formal_superiority_claim","x3_started","x4_started","x5_started"],"properties":{"terminal":{"type":"boolean"},"immutable":{"type":"boolean"},"complete":{"type":"boolean"},"next_authorization":{"enum":["NONE","NONE_REQUIRES_OWNER_AUTHORIZATION","X2_R1_NNS_V2_DEVELOPMENT_AND_FUTILITY_RECOVERY_ONLY"]},"formal_superiority_claim":{"const":false},"x3_started":{"const":false},"x4_started":{"const":false},"x5_started":{"const":false}}},
    "payload": {"type":"object","additionalProperties":false,"required":["identity","bindings","checks","metrics","files","counts","state","resources","terminal"],"properties":{"identity":{"type":"array","items":{"$ref":"#/$defs/namedScalar"},"uniqueItems":true},"bindings":{"type":"array","items":{"$ref":"#/$defs/file"},"uniqueItems":true},"checks":{"type":"array","items":{"$ref":"#/$defs/check"},"uniqueItems":true},"metrics":{"type":"array","items":{"$ref":"#/$defs/metric"},"uniqueItems":true},"files":{"type":"array","items":{"oneOf":[{"$ref":"#/$defs/file"},{"$ref":"#/$defs/array"}]},"uniqueItems":true},"counts":{"type":"array","items":{"$ref":"#/$defs/namedScalar"},"uniqueItems":true},"state":{"type":"array","items":{"$ref":"#/$defs/namedScalar"},"uniqueItems":true},"resources":{"$ref":"#/$defs/resource"},"terminal":{"$ref":"#/$defs/terminalState"}}},
    "envelope": {"type":"object","additionalProperties":false,"required":["$schema","schema_version","document_type","stage_id","run_id","status","payload","canonical_digest"],"properties":{"$schema":{"const":"stage_x_x2_r1_artifact.schema.json"},"schema_version":{"const":1},"document_type":{"type":"string"},"stage_id":{"const":"X2-R1"},"run_id":{"const":"STAGE_X_X2_R1_V1_20260909"},"status":{"enum":["PENDING","PASS","VALID","FAILED","NA","NO_GO_METHOD_VALIDITY","NO_GO_CLASS_LOGIT_COMPLETENESS","NO_GO_BROAD_CLAIM_DEVELOPMENT","BLOCKED_INFRASTRUCTURE","BLOCKED_DETERMINISTIC_MEMORY_PLAN","BLOCKED_BUDGET"]},"payload":{"$ref":"#/$defs/payload"},"canonical_digest":{"$ref":"#/$defs/sha"}}},

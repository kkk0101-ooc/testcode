{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "document_type", "record_id", "status", "amendment", "producer_git", "launch_record_commit", "c8_salvage", "model", "contracts", "outputs", "scope", "canonical_digest"],
  "properties": {
    "$schema": {"const": "recovery_c9_launch_record.schema.json"},
    "schema_version": {"const": 1},
    "document_type": {"const": "vitnns_recovery_c9_launch_record"},
    "record_id": {"const": "RECOVERY_C9_SALVAGE_C8_20260903"},
    "status": {"const": "AUTHORIZED_FOR_RECOVERY_C9_ONLY"},
    "amendment": {"$ref": "#/$defs/file_commit"},
    "producer_git": {"$ref": "#/$defs/producer"},
    "launch_record_commit": {"type": "string", "pattern": "^(SELF|[0-9a-f]{40})$"},
    "c8_salvage": {"type": "object"},
    "model": {"type": "object"},
    "contracts": {"type": "object"},
    "outputs": {"type": "object"},
    "scope": {"type": "object"},
    "canonical_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "file_commit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "file_sha256", "containing_commit"],
      "properties": {
        "id": {"const": "RECOVERY-C9-SALVAGE-C8-20260903"},
        "path": {"type": "string"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "containing_commit": {"$ref": "#/$defs/commit"}
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "source_subtree_path", "source_subtree_tree", "dirty"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "tree": {"$ref": "#/$defs/commit"},
        "source_subtree_path": {"const": "src/vitnns"},
        "source_subtree_tree": {"$ref": "#/$defs/commit"},
        "dirty": {"const": false}
      }
    }
  }
}

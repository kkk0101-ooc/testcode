{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "stage_f_f3_run_spec.schema.json"},
    "schema_version": {"const": 1},
    "document_type": {"const": "stage_f_f3_run_spec"},
    "stage_id": {"const": "F3"},
    "authorization": {"type": "object"},
    "operations": {"type": "array", "minItems": 6},
    "prohibited_operations": {"type": "array", "minItems": 7},
    "outputs": {"type": "object"},
    "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["$schema", "schema_version", "document_type", "stage_id", "authorization", "operations", "prohibited_operations", "outputs", "canonical_digest"]
}

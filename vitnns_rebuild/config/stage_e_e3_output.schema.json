{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitnns.local/schemas/stage_e_e3_output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "table_id", "columns", "row_count", "rows", "canonical_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "document_type": {"const": "stage_e_e3_paper_table"},
    "table_id": {"enum": ["layer_head_method_rows", "layer_head_paired_delta", "prediction_strata", "prediction_strata_membership", "resource_and_qc"]},
    "columns": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "row_count": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["variant_id", "sample_id", "selection_order", "cohort", "stratum", "validity_status", "source_hashes", "method", "target", "scale", "layer", "head"], "properties": {"validity_status": {"enum": ["VALID", "FAILED", "NA"]}, "stratum": {"enum": ["overall", "correct", "misclassified"]}, "cohort": {"const": "stage_d_fidelity_v1_500"}, "target": {"const": "fixed_clean_attention_cls_head_direction"}}}},
    "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

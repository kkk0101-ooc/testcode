{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Closed S4 immutable unit terminal",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "study_id", "stage_id", "run_id", "document_type", "status", "payload", "producer_commit", "canonical_digest"],
  "properties": {
    "$schema": {"const": "s4_artifact.schema.json"},
    "schema_version": {"const": 1},
    "study_id": {"const": "NNS_VIT_PATCH_DEPTH_SEMANTICS"},
    "stage_id": {"const": "S4"},
    "run_id": {"const": "s4_r4_20260915"},
    "document_type": {"const": "s4_unit_terminal"},
    "status": {"enum": ["VALID_NNS", "VALID_OCCLUSION", "NA_GEOMETRY_SIZE_MISMATCH", "NA_TARGET_DISAPPEARED_AFTER_CROP", "NA_MASK_LABEL_OUT_OF_RANGE", "NA_VOID_MASK", "NA_ZERO_POSITIVE_MASS", "NA_MATCHED_CONTROL_UNAVAILABLE", "NA_INCOMPLETE_DEPTH_TRAJECTORY", "NA_UPSTREAM_NNS", "FAILED_NUMERICAL", "FAILED_NNS", "FAILED_OCCLUSION", "BLOCKED_DATA_INTEGRITY", "BLOCKED_INFRASTRUCTURE", "FAILED_IMPLEMENTATION"]},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_type", "schedule_index", "source_id", "image_sha256", "mask_sha256", "class_target", "annotation_label_id", "role_flags", "component", "operator", "dependency_terminal", "launch_id", "claim_path", "claim_time_unix_ns", "worker_id", "worker_pid", "physical_gpu_index", "gpu_uuid", "started_unix_ns", "completed_unix_ns", "python_executable_realpath", "producer_commit", "quadrature_attempts", "quadrature_selected_steps", "model_forward_counts_summary", "geometry", "resources", "terminal_state", "typed_failure_or_na", "formal_archive_member_reads_by_worker", "S3_D2_prediction_error_numeric_reads", "cohort_level_inference_count", "scientific_claim_decision"],
      "properties": {
        "unit_type": {"enum": ["NNS_IMAGE", "OCCLUSION_PRIMARY", "OCCLUSION_SENSITIVITY"]},
        "schedule_index": {"type": "integer", "minimum": 0, "maximum": 1743},
        "source_id": {"type": "string", "minLength": 1},
        "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mask_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "class_target": {"type": "integer", "minimum": 0, "maximum": 999},
        "annotation_label_id": {"type": "integer", "minimum": 1, "maximum": 919},
        "role_flags": {"type": "object", "minProperties": 6},
        "component": {"type": ["string", "null"]},
        "operator": {"type": ["string", "null"]},
        "dependency_terminal": {"type": ["object", "null"]},
        "launch_id": {"type": "string"},
        "claim_path": {"type": "string"},
        "claim_time_unix_ns": {"type": "integer"},
        "worker_id": {"type": "string"},
        "worker_pid": {"type": "integer"},
        "physical_gpu_index": {"type": "integer"},
        "gpu_uuid": {"type": "string"},
        "started_unix_ns": {"type": "integer"},
        "completed_unix_ns": {"type": "integer"},
        "python_executable_realpath": {"type": "string"},
        "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "quadrature_attempts": {"type": "array"},
        "quadrature_selected_steps": {"type": ["integer", "null"]},
        "model_forward_counts_summary": {"type": "object"},
        "geometry": {"type": "object"},
        "target": {"type": "object"},
        "native_hooked_parity": {"type": "object"},
        "nns": {"type": "object"},
        "p1": {"type": "object"},
        "p2_plan": {"type": "object"},
        "arrays": {"type": "array"},
        "model_forward_counts": {"type": "object"},
        "clean_logit": {"type": "number"},
        "coordinate_count": {"type": "integer"},
        "selected_plus_control_logits_per_coordinate": {"type": "integer"},
        "patch_ids_and_matching_diagnostics": {"type": "object"},
        "mask_digests": {"type": "array"},
        "matching_maximum_attempts": {"type": "integer"},
        "operator_identity": {"type": "string"},
        "coordinate_plan_shared_between_operators": {"type": "boolean"},
        "operator_selected_from_logit_drop": {"type": "boolean"},
        "model_forward_calls": {"type": "integer"},
        "resources": {"type": "object"},
        "terminal_state": {"type": "string"},
        "typed_failure_or_na": {"type": ["object", "null"]},
        "formal_archive_member_reads_by_worker": {"const": 0},
        "S3_D2_prediction_error_numeric_reads": {"const": 0},
        "cohort_level_inference_count": {"const": 0},
        "scientific_claim_decision": {"type": "null"}
      }
    }
  }
}

        "annotation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "annotation_wnid": {"type": "string"}, "annotation_label_id": {"type": "integer", "minimum": 1, "maximum": 919}, "formal_class_rank": {"type": "integer", "minimum": 0, "maximum": 871},
        "mask_width": {"type": "integer", "minimum": 1}, "mask_height": {"type": "integer", "minimum": 1}, "target_model_class_index": {"type": "integer", "minimum": 0, "maximum": 999},
        "role_flags": {"type": "object", "additionalProperties": false, "required": ["S4_NNS", "S4_occlusion", "P1", "P2", "D1", "D2", "pilot", "probe_train", "probe_validation"], "properties": {"S4_NNS": {"const": true}, "S4_occlusion": {"const": true}, "P1": {"const": true}, "P2": {"const": true}, "D1": {"const": true}, "D2": {"const": true}, "pilot": {"const": false}, "probe_train": {"const": false}, "probe_validation": {"const": false}}},
        "selection_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "image_archive_member": {"type": "string"}, "mask_archive_member": {"type": "string"}, "resolution_join": {"const": "S0_R3_EXACT_SEVEN_FIELD_IDENTITY_ONE_TO_ONE"}
      }

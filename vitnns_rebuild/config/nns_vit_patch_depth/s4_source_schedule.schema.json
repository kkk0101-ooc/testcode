    "schema_version": {"const": 1}, "study_id": {"const": "NNS_VIT_PATCH_DEPTH_SEMANTICS"},
    "stage_id": {"const": "S4"}, "run_id": {"const": "s4_r4_20260915"},
    "document_type": {"const": "s4_source_schedule"}, "status": {"const": "FROZEN"},
    "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["source_image_count", "class_count", "images_per_class", "source_id_unique", "image_sha256_unique", "candidate_m4_D2_only_excluded_count", "pilot_probe_train_probe_validation_excluded", "order_rule", "records_digest", "audit_subset_schedule_indices", "audit_subset_namespace", "records"],
      "properties": {
        "source_image_count": {"const": 1744}, "class_count": {"const": 872}, "images_per_class": {"const": 2},
        "source_id_unique": {"const": true}, "image_sha256_unique": {"const": true},
        "candidate_m4_D2_only_excluded_count": {"const": 1738}, "pilot_probe_train_probe_validation_excluded": {"const": true},
        "order_rule": {"const": "candidate_m4_record_order_filtered_by_all_six_S4_roles"},
        "records_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "audit_subset_schedule_indices": {"type": "array", "minItems": 64, "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 1743}},
        "audit_subset_namespace": {"const": "NNS_VIT_PATCH_DEPTH_S2_R4_AUDIT_SUBSET_V1"},
        "records": {"type": "array", "minItems": 1744, "maxItems": 1744, "items": {"$ref": "#/definitions/record"}}
      }
    }
  },
  "definitions": {
    "record": {
      "type": "object", "additionalProperties": false,

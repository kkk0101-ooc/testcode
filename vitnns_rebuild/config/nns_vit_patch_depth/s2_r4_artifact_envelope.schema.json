{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "stage_id", "run_id", "document_type", "status", "payload", "canonical_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"const": "NNS_VIT_PATCH_DEPTH_SEMANTICS"},
    "stage_id": {"const": "S2-R4"},
    "run_id": {"const": "s2_r4_20260914"},
    "document_type": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "BLOCKED_SCIENTIFIC_VALIDITY", "BLOCKED_DATA_INTEGRITY", "BLOCKED_INFRASTRUCTURE", "FAILED_IMPLEMENTATION"]},
    "payload": {"type": "object"},
    "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Closed S4 group-sequential recovery artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "stage_id", "run_id", "document_type", "status", "payload", "canonical_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"const": "NNS_VIT_PATCH_DEPTH_SEMANTICS"},
    "stage_id": {"const": "S4-GROUP-SEQUENTIAL-RECOVERY"},
    "run_id": {"const": "s4_r9_group_sequential_20260915"},
    "document_type": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "payload": {"$ref": "#/definitions/object"},
    "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "definitions": {
    "object": {"type": "object", "patternProperties": {"^.*$": {"$ref": "#/definitions/value"}}, "additionalProperties": false},
    "array": {"type": "array", "items": {"$ref": "#/definitions/value"}},
    "value": {"oneOf": [{"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string"}, {"$ref": "#/definitions/object"}, {"$ref": "#/definitions/array"}]}
  }
}

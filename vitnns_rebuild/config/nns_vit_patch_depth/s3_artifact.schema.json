{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s3_artifact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema","schema_version","study_id","stage_id","run_id","document_type","status","payload","canonical_digest"],
  "properties": {
    "$schema": {"const":"s3_artifact.schema.json"},
    "schema_version": {"const":1},
    "study_id": {"const":"NNS_VIT_PATCH_DEPTH_SEMANTICS"},
    "stage_id": {"const":"S3"},
    "run_id": {"enum":["s3_r3_20260914","s3_r4_20260914","s3_r5_20260915"]},
    "document_type": {"type":"string","minLength":1},
    "status": {"type":"string","minLength":1},
    "producer_commit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "payload": {"type":"object"},
    "canonical_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if":{"properties":{"document_type":{"const":"s3_unit_terminal"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/unit_terminal"}}}},
    {"if":{"properties":{"document_type":{"const":"s3_launch_manifest"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/launch_manifest"}}}},
    {"if":{"properties":{"document_type":{"const":"s3_array_manifest"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/array_manifest"}}}}
  ],
  "$defs": {
    "array_record": {
      "type":"object","additionalProperties":false,
      "required":["path","sha256","canonical_array_digest","bytes","shape","dtype","axes","producer_commit","source_identity","recomputation_rule"],
      "properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"canonical_array_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"bytes":{"type":"integer","minimum":0},"shape":{"type":"array","items":{"type":"integer","minimum":0}},"dtype":{"enum":["float32","float64"]},"axes":{"type":"array","items":{"type":"string"}},"producer_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"source_identity":{"type":"string"},"recomputation_rule":{"type":"string"}}
    },
    "unit_terminal": {
      "type":"object","additionalProperties":false,
      "required":["schedule_index","source_image_id","image_sha256","annotation_sha256","split","annotation_wnid","target_model_class_index","role_flags","launch_id","claim_path","claim_time_ns","worker_id","worker_pid","physical_gpu_index","gpu_uuid","started_time_ns","completed_time_ns","python_executable_realpath","producer_commit","arrays","resources","terminal_state","failure_reason","access"],
      "properties": {
        "schedule_index":{"type":"integer","minimum":0,"maximum":10457},"source_image_id":{"type":"string"},"image_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"annotation_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"split":{"enum":["probe_train","probe_validation","d2_test"]},"annotation_wnid":{"type":"string"},"target_model_class_index":{"type":"integer","minimum":0,"maximum":999},"role_flags":{"type":"object","additionalProperties":{"type":"boolean"}},"launch_id":{"type":"string"},"claim_path":{"type":"string"},"claim_time_ns":{"type":"integer","minimum":0},"worker_id":{"type":"string"},"worker_pid":{"type":"integer","minimum":1},"physical_gpu_index":{"type":"integer","minimum":0},"gpu_uuid":{"type":"string"},"started_time_ns":{"type":"integer","minimum":0},"completed_time_ns":{"type":"integer","minimum":0},"python_executable_realpath":{"type":"string"},"producer_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"arrays":{"type":"array","items":{"$ref":"#/$defs/array_record"}},
        "resources":{"type":"object","additionalProperties":false,"required":["gpu_active_seconds","cpu_seconds","unit_wall_seconds","retained_bytes","peak_allocated_gpu_bytes","peak_reserved_gpu_bytes"],"properties":{"gpu_active_seconds":{"type":"number","minimum":0},"cpu_seconds":{"type":"number","minimum":0},"unit_wall_seconds":{"type":"number","minimum":0},"retained_bytes":{"type":"integer","minimum":0},"peak_allocated_gpu_bytes":{"type":"integer","minimum":0},"peak_reserved_gpu_bytes":{"type":"integer","minimum":0}}},
        "terminal_state":{"enum":["VALID_FEATURE","NA_GEOMETRY_SIZE_MISMATCH","NA_TARGET_DISAPPEARED_AFTER_CROP","NA_MASK_LABEL_OUT_OF_RANGE","NA_VOID_MASK","NA_D2_REQUIRED_SPLIT_OR_MODEL_MISSING","FAILED_NUMERICAL","FAILED_FEATURE_EXTRACTION","BLOCKED_DATA_INTEGRITY","BLOCKED_INFRASTRUCTURE","FAILED_IMPLEMENTATION"]},"failure_reason":{"type":["string","null"]},
        "access":{"type":"object","additionalProperties":false,"required":["image_member_read_count","mask_member_read_count","decode_count","feature_extraction_count","prediction_count"],"properties":{"image_member_read_count":{"type":"integer","minimum":0},"mask_member_read_count":{"type":"integer","minimum":0},"decode_count":{"type":"integer","minimum":0},"feature_extraction_count":{"type":"integer","minimum":0},"prediction_count":{"type":"integer","minimum":0}}}
      }
    },
    "launch_manifest": {
      "type":"object","additionalProperties":false,"required":["launch_id","phase","gpu_snapshot","selected_gpus","worker_count","fixed_gpu_set","dynamic_queue","static_sharding","created_time_ns"],
      "properties":{"launch_id":{"type":"string"},"phase":{"enum":["train_validation","test"]},"gpu_snapshot":{"type":"array","items":{"type":"object"}},"selected_gpus":{"type":"array","items":{"type":"object"}},"worker_count":{"type":"integer","minimum":0,"maximum":8},"fixed_gpu_set":{"const":true},"dynamic_queue":{"const":true},"static_sharding":{"const":false},"created_time_ns":{"type":"integer","minimum":0}}
    },
    "array_manifest": {
      "type":"object","additionalProperties":false,"required":["records","records_digest","count"],
      "properties":{"records":{"type":"array","items":{"$ref":"#/$defs/array_record"}},"records_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"count":{"type":"integer","minimum":0}}
    }
  }
}

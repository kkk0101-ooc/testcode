    "formal_sample_count": {"const": 50},
    "methods": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}},
    "attempt_id": {"const": "attempt-000001"},
    "execution": {"type": "object"},
    "budget": {"type": "object"},
    "access": {"type": "object"},

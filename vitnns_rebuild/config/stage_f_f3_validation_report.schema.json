{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": 1},
    "document_type": {"const": "stage_f_f3_validation_report"},
    "stage_id": {"const": "F3"},
    "status": {"const": "PASS"},
    "checks": {"type": "object", "minProperties": 21},

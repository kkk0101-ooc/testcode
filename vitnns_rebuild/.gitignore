__pycache__/
*.py[cod]
.pytest_cache/
.coverage
build/
dist/
*.egg-info/

# Local runtime products. The lightweight rerun branch tracks code, docs,
# manifests, and environment/configuration only. Large model/data payloads and
# generated evidence/report roots stay local and can be restored from the
# documented asset checklist.
outputs/
artifacts/
evidence/
evidence/**
reports/
reports/**

# C0 contracts: these small manifests are evidence, not runtime artifacts.
!manifests/stage_c_flat_val_500/manifest.csv
!manifests/stage_c_flat_val_500/manifest_metadata.json
!manifests/stage_c_sample_registry.csv
!manifests/stage_c_sample_registry_metadata.json

# D1 registry controls only; never unignore reserve JPEGs or runtime/results.
!manifests/stage_d_fidelity_v1/stage_d_registry_package.schema.json
!manifests/stage_d_fidelity_v1/source_binding.json
!manifests/stage_d_fidelity_v1/registry.json
!manifests/stage_d_fidelity_v1/pre_authorization_access_attestation.json
!manifests/stage_d_fidelity_v1/registry_metadata.json
!manifests/stage_d_fidelity_v1/manifest.json

# Keep asset documentation, manifests, and helper scripts in Git.
!assets/
!assets/README.md
!assets/RECOVERY_STATUS.md
!assets/assemble_imagenet_val.sh
!assets/download_imagenet_val.sh
!assets/manifests/
!assets/manifests/**

# Local model and ImageNet payload caches.
assets/models/
assets/models/**
assets/imagenet/
assets/imagenet/**
!assets/imagenet/
!assets/imagenet/ILSVRC2012_img_val.parts.sha256
!assets/imagenet/ILSVRC2012_img_val.tar.md5
assets/imagenet/ILSVRC2012_img_val.tar
assets/imagenet/ILSVRC2012_img_val.complete.tar
assets/imagenet/ILSVRC2012_img_val.parts/*.partial
assets/imagenet/ILSVRC2012_img_val.parts/part-*
assets/imagenet/ILSVRC2012_devkit_t12.tar.gz
assets/imagenet/imagenet_2012_validation_synset_labels.txt

# Stage C and Stage D JPEGs are materialized locally from the bound ImageNet tar.
assets/data/
assets/data/**


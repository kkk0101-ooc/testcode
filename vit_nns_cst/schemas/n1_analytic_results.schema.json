{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "determinism": {"type": "object", "additionalProperties": false, "required": ["common_digest", "process_count", "runs", "status"], "properties": {"common_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "process_count": {"const": 2}, "runs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["digest", "pythonhashseed"], "properties": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "pythonhashseed": {"type": "string"}}}}, "status": {"const": "PASS"}}},
    "document_type": {"const": "nns_cst_n1_analytic_results"},
    "environment": {"type": "object", "additionalProperties": false, "required": ["cuda_visible_devices", "device", "python_version", "sys_executable", "third_party_runtime_dependencies"], "properties": {"cuda_visible_devices": {"const": ""}, "device": {"const": "CPU"}, "python_version": {"type": "string"}, "sys_executable": {"type": "string"}, "third_party_runtime_dependencies": {"const": []}}},
    "execution_boundary": {"type": "object", "additionalProperties": false, "required": ["checkpoint_deserializations", "formal_image_decodes", "formal_outcome_reads", "gpu_or_cuda_uses", "inference_runs", "model_loads", "n2_started", "training_runs"], "properties": {"checkpoint_deserializations": {"const": 0}, "formal_image_decodes": {"const": 0}, "formal_outcome_reads": {"const": 0}, "gpu_or_cuda_uses": {"const": 0}, "inference_runs": {"const": 0}, "model_loads": {"const": 0}, "n2_started": {"const": false}, "training_runs": {"const": 0}}},
    "fixtures": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["assertions", "fixture_id"], "properties": {"assertions": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["assertion", "max_abs_error", "passed"], "properties": {"assertion": {"type": "string"}, "max_abs_error": {"type": "number", "minimum": 0}, "observed_failure": {"type": "string"}, "passed": {"const": true}}}}, "fixture_id": {"type": "string"}}}},
    "microbenchmark": {"type": "object", "additionalProperties": false, "required": ["cpu_seconds", "iterations", "iterations_per_second", "peak_rss_kib", "wall_seconds"], "properties": {"cpu_seconds": {"type": "number", "minimum": 0}, "iterations": {"const": 200}, "iterations_per_second": {"type": "number", "exclusiveMinimum": 0}, "peak_rss_kib": {"type": "integer", "minimum": 0}, "wall_seconds": {"type": "number", "exclusiveMinimum": 0}}},
    "mutations": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["expected_failure", "mutation_id", "observed_failure", "passed"], "properties": {"expected_failure": {"type": "string"}, "mutation_id": {"type": "string"}, "observed_failure": {"type": "string"}, "passed": {"const": true}}}},
    "schema_version": {"const": 1},
    "scientific_payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage_id": {"const": "N1"},
    "status": {"const": "PASS_N1_ANALYTIC_FIXTURES"}
  },
  "required": ["determinism", "document_type", "environment", "execution_boundary", "fixtures", "microbenchmark", "mutations", "schema_version", "scientific_payload_digest", "stage_id", "status"],
  "title": "NNS-CST N1 analytic results",
  "type": "object"
}

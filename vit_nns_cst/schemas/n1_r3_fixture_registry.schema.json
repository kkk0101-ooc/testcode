{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "determinism_probe": {"type": "object", "additionalProperties": false, "required": ["comparison", "process_count", "pythonhashseed_values"], "properties": {"comparison": {"type": "string"}, "process_count": {"const": 2}, "pythonhashseed_values": {"const": ["0", "99173"]}}},
    "document_type": {"const": "nns_cst_n1_fixture_registry"},
    "fixtures": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "required_assertions"], "properties": {"fixture_id": {"type": "string", "minLength": 1}, "required_assertions": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true}}}},
    "microbenchmark": {"type": "object", "additionalProperties": false, "required": ["iterations", "operations", "report"], "properties": {"iterations": {"const": 200}, "operations": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 3}, "report": {"type": "array", "items": {"type": "string"}, "minItems": 4, "maxItems": 4}}},
    "mutations": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["expected_failure", "mutation_id"], "properties": {"expected_failure": {"type": "string", "minLength": 1}, "mutation_id": {"type": "string", "minLength": 1}}}},
    "numeric_contract": {"type": "object", "additionalProperties": false, "required": ["atol", "device", "dtype", "rtol"], "properties": {"atol": {"const": 1e-09}, "device": {"const": "CPU"}, "dtype": {"const": "float64"}, "rtol": {"const": 1e-07}}},
    "schema_version": {"const": 1},
    "stage_id": {"const": "N1"},
    "status": {"const": "FROZEN_BEFORE_N1_TEST_EXECUTION"}
  },
  "required": ["determinism_probe", "document_type", "fixtures", "microbenchmark", "mutations", "numeric_contract", "schema_version", "stage_id", "status"],
  "title": "NNS-CST N1-R3 fixture registry",
  "type": "object"
}

# Default to ignoring everything; explicitly allow source, contracts, recovery
# assets, and LFS-managed experiment artifacts.
*
!*/

# Versioned code and documentation.
!.gitignore
!**/.gitignore
!.gitattributes
!*.py
!**/*.py
!*.sh
!**/*.sh
!*.ps1
!**/*.ps1
!*.md
!**/*.md
!requirements*.txt
!**/requirements*.txt
!*.json
!**/*.json
!*.schema.json
!**/*.schema.json
!*.csv
!**/*.csv
!*.lock
!**/*.lock
!*.yml
!**/*.yml

# Keep generated caches out even when directories are traversable.
__pycache__/
**/__pycache__/
*.py[cod]
.cache/
.runtime/
.micromamba/
.conda/
.python/
.venv/
**/.pytest_cache/
**/.coverage
**/__pycache__/

# Explicitly exclude legacy dumps and non-authoritative generated outputs.
scan_vit/
chatlog1/
论文1/
**/scan_results/
**/analysis_results*/
**/PPT_Images/
**/cams/
**/do_images/
**/do_imagenet*/
**/trained_model*/
**/figures/
**/media/
**/visualize_attention/
**/visualize_v/
**/gpt生成图片/
**/training_visualizations/
**/ppt_results*/

# Current rebuild is versioned selectively. Large binary assets under
# vitnns_rebuild/assets stay in Git LFS. Formal experiment evidence is retained
# locally unless a specific small manifest/report is intentionally allowlisted.
!vitnns_rebuild/
!vitnns_rebuild/**/
!vitnns_rebuild/assets/
!vitnns_rebuild/assets/**
vitnns_rebuild/evidence/
vitnns_rebuild/evidence/**
vitnns_rebuild/outputs/
vitnns_rebuild/artifacts/
vitnns_rebuild/assets/imagenet/ILSVRC2012_img_val.tar
vitnns_rebuild/assets/imagenet/ILSVRC2012_img_val.complete.tar
vitnns_rebuild/assets/imagenet/ILSVRC2012_img_val.parts/*.partial

# Keep archives and documents that are not explicitly part of assets/evidence
# out of normal Git by default.
*.pt
*.pth
*.npy
*.npz
*.parquet
*.png
*.jpg
*.jpeg
*.JPEG
*.tar.gz
*.zip
*.gif
*.webp
*.bmp
*.svg
*.pdf
*.pptx
*.html
*.log
!requirements*.txt
!**/requirements*.txt

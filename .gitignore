# Default to ignoring everything; explicitly allow source and Markdown only.
*
!*/

# Versioned code and documentation.
!.gitignore
!**/.gitignore
!*.py
!**/*.py
!*.sh
!**/*.sh
!*.ps1
!**/*.ps1
!*.md
!**/*.md
!requirements*.txt
!**/requirements*.txt

# Keep generated caches out even when directories are traversable.
__pycache__/
**/__pycache__/
*.py[cod]

# Explicitly exclude large datasets, model artifacts, media, and result dumps.
scan_vit/
chatlog1/
vitnns_rebuild/
**/scan_results/
**/analysis_results*/
**/PPT_Images/
**/cams/
**/do_images/
**/do_imagenet*/
**/trained_model*/
**/model/
**/datas/
**/data/
**/figures/
**/media/
**/visualize_attention/
**/visualize_v/
**/gpt生成图片/
**/training_visualizations/
**/ppt_results*/

# Common heavy/generated file types.
*.zip
*.pt
*.pth
*.npy
*.npz
*.png
*.jpg
*.jpeg
*.JPEG
*.gif
*.webp
*.bmp
*.svg
*.pdf
*.pptx
*.html
*.log
*.csv
*.txt
!requirements*.txt
!**/requirements*.txt
